# Copy to .env and fill in your own values. Never commit .env.
# The application reads environment variables only; it never reads a secret
# from a committed file.

# --- database ---------------------------------------------------------------
# PostgreSQL is the production path. The demo runner can use SQLite locally.
DATABASE_URL=postgresql+psycopg://skyq:choose-a-local-password@127.0.0.1:5432/skyq_range
# DATABASE_URL=sqlite:///var/skyq_range.db

# --- API / dashboard --------------------------------------------------------
SKYQ_API_HOST=127.0.0.1
SKYQ_API_PORT=8000
SKYQ_CONTROL_ENABLED=false
SKYQ_CONTROL_TOKEN=
SKYQ_LOG_LEVEL=INFO

# --- market data ------------------------------------------------------------
# Databento: historical consolidated US-equity 1-minute bars.
DATABENTO_API_KEY=
DATABENTO_DATASET=EQUS.MINI

# London Strategic Edge (LSE): archive + live WebSocket data.
# This is a data vendor, not a broker; execution still goes through a broker.
LSE_API_KEY=
# Optional key-file path for scripts.run_lse_bridge; keep it outside Git.
LSE_API_KEY_FILE=
LSE_WARMUP_DAYS=45
LSE_BAR_GRACE_SECONDS=5

# moomoo OpenD (local gateway, no API key is stored here).
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_PAPER_ONLY=true

# --- brokers ----------------------------------------------------------------
# IBKR: use the paper Gateway port 4002 unless you intentionally choose live.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=46
IB_ACCOUNT=
IB_READONLY=0

# Alpaca: paper endpoint is fixed by the adapter. Use a dedicated paper account.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# MetaTrader 5 (Windows only). Select a demo/contest account first.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL_MAP=SPY=SPY,QQQ=QQQ
MT5_MAGIC=2026111501

# --- live risk --------------------------------------------------------------
SKYQ_RANGE_SIDES=both
SKYQ_RANGE_SESSION=rth
SKYQ_RANGE_MAX_RISK_PCT=0.02
SKYQ_RANGE_MAX_NOTIONAL_PCT=1.00
SKYQ_RANGE_DAILY_LOSS_STOP_PCT=0.03

# --- postgres bootstrap (used only by local scripts) ------------------------
POSTGRES_DB=skyq_range
POSTGRES_USER=skyq
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
